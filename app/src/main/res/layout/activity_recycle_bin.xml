<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/add_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    >

    <!-- Modern Header with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="16dp"
            app:tint="#2563EB" />

        <!-- Title with Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/trash_bin"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/recyclebin_title"
                android:text="Recycle Bin"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_empty_bin"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Empty Bin"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/button_outline_red"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_restore_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Restore All"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/button_outline_blue" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Card with 3 Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:padding="16dp"
        android:layout_margin="16dp"
        android:elevation="2dp"
        android:background="@drawable/card_background">

        <!-- Customers Count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:text="Customers"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/customers_count"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#E2E8F0" />

        <!-- Transactions Count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:text="Transactions"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/transactions_count"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#E2E8F0" />

        <!-- Total Count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:text="Total"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/total_count"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="0dp">

        <!-- Section Header with Pagination Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="Deleted Items"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/page_info"
                    android:text="Showing 0 of 0 items"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/sort_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort ▼"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:drawablePadding="4dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="12dp" />

                <!-- Items per page selector -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/button_outline_gray"
                    android:padding="4dp"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:text="Items per page:"
                        android:textSize="10sp"
                        android:textColor="#64748B"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp" />

                    <Spinner
                        android:id="@+id/items_per_page_spinner"
                        android:layout_width="40dp"
                        android:layout_height="28dp"
                        android:background="@android:color/transparent"
                        android:popupBackground="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Scrollable Content with Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="40dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_empty_recycle"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:text="Recycle Bin is Empty"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Deleted customers and transactions will appear here"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Items List -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TableLayout
                    android:id="@+id/recycle_bin_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:background="@drawable/table_background"
                    android:divider="@android:color/transparent"
                    android:showDividers="none" />
            </ScrollView>
        </FrameLayout>

        <!-- Pagination Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/table_background"
            android:layout_marginTop="8dp">

            <!-- First Page -->
            <ImageView
                android:id="@+id/btn_first_page"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_first_page"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_marginEnd="8dp"
                app:tint="#64748B" />

            <!-- Previous Page -->
            <ImageView
                android:id="@+id/btn_prev_page"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chevron_left"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_marginEnd="16dp"
                app:tint="#64748B" />

            <!-- Page Numbers -->
            <LinearLayout
                android:id="@+id/page_numbers_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center" />

            <!-- Next Page -->
            <ImageView
                android:id="@+id/btn_next_page"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chevron_right"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_marginStart="16dp"
                app:tint="#64748B" />

            <!-- Last Page -->
            <ImageView
                android:id="@+id/btn_last_page"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_last_page"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_marginStart="8dp"
                app:tint="#64748B" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>