<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/add_activity_bg"
    tools:context=".AddTransactionActivity">

    <!-- Compact Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" Transaction"
            android:textColor="@color/purple_500"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!--            <Button-->
            <!--                android:id="@+id/btn_export_pdf"-->
            <!--                android:layout_width="50dp"-->
            <!--                android:layout_height="30dp"-->
            <!--                android:text="PDF"-->
            <!--                android:textCoQlor="@color/purple_700"-->
            <!--                android:background="@drawable/info_background"-->
            <!--                android:textSize="10sp"-->
            <!--                android:textStyle="bold"-->
            <!--                android:layout_marginEnd="8dp" />-->

            <Button
                android:id="@+id/btn_save_transaction"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:text="SAVE"
                android:textColor="@android:color/white"
                android:background="@drawable/save_button_gradient"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium"
                android:elevation="2dp"
                android:stateListAnimator="@null"
                android:paddingHorizontal="12dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:fitsSystemWindows="true"
        android:paddingBottom="80dp"
        android:layout_below="@id/header">

        <LinearLayout
            android:id="@+id/form_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/add_card_background1"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinner_status"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:paddingStart="10dp" />
            </LinearLayout>

            <!-- Transaction Name & Notes Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/add_card_background1"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transaction Name"
                    android:textColor="#2D3748"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_transaction_name"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edit_text_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:hint="Enter name" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notes"
                    android:textColor="#2D3748"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_note"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/edit_text_bg"
                    android:gravity="top"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:hint="Enter notes" />
            </LinearLayout>

            <!-- Debit & Credit Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/add_card_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transaction Details"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Debit Side -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="DEBIT"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="#F0FFF4"
                            android:padding="8dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textColor="#4A5568"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <EditText
                            android:id="@+id/et_date"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:hint="dd-mm-yyyy"
                            android:inputType="date"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Debit Weight"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                        <EditText
                            android:id="@+id/et_debit_weight"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Touch"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                        <EditText
                            android:id="@+id/et_debit_touch"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Wastage"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                        <EditText
                            android:id="@+id/et_debit_wastage"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00" />

                        <TextView
                            android:id="@+id/tv_debit_pure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Debit Pure: 0.00"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="#F0FFF4"
                            android:padding="10dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Credit Side -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CREDIT"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="#FEF2F2"
                            android:padding="8dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Particulars"
                            android:textColor="#4A5568"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />

                        <EditText
                            android:id="@+id/et_particulars"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="text"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="Enter particulars" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Credit Weight"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                        <EditText
                            android:id="@+id/et_credit_weight"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Touch"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                        <EditText
                            android:id="@+id/et_credit_touch"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Wastage"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                        <EditText
                            android:id="@+id/et_credit_wastage"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00" />

                        <TextView
                            android:id="@+id/tv_credit_pure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Credit Pure: 0.00"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="#FEF2F2"
                            android:padding="10dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E2E8F0" />

                <!-- Dynamic Rows Container -->
                <LinearLayout
                    android:id="@+id/container_dynamic_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"/>

                <!-- Totals -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/tv_total_debit_weight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:paddingStart="6dp"
                        android:text="Total DP: 0.00"
                        android:textColor="#059669"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_credit_weight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:paddingStart="6dp"
                        android:text="Total CP: 0.00"
                        android:textColor="#DC2626"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Remaining: 0.00"
                    android:textColor="#7E22CE"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/show_cash_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Show Cash Details"
                android:visibility="gone"
                android:textColor="@color/purple_700"
                android:textStyle="bold" />


            <!-- Cash Details Card -->
            <LinearLayout
                android:id="@+id/layoutCashDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/add_card_background"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:elevation="1dp"
                android:visibility="gone">

                <!-- Header Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cash Details"
                    android:textColor="#2D3748"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="4dp" />

                <!-- Two Column Layout for Cash -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Debit Cash Side -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="6dp"
                        android:background="@drawable/add_card_background"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Debits cash"
                            android:textColor="#059669"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textColor="#4A5568"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <EditText
                            android:id="@+id/et_cash_date_debit"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/edit_text_bg"
                            android:hint="dd-mm-yyyy"
                            android:inputType="date"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Debit Cash"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <EditText
                            android:id="@+id/et_debit_cash_amount"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rate Cutting"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <EditText
                            android:id="@+id/et_debit_rate_cutting"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00"
                            android:layout_marginBottom="12dp" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Debit Pure"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tv_debit_cash_pure"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:text="0.00"
                            android:background="#F0FFF4"
                            android:gravity="center"
                            android:padding="8dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#059669"
                            android:layout_marginBottom="12dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginVertical="8dp" />
                    </LinearLayout>
                    <!-- Credit Cash Side -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="6dp"
                        android:background="@drawable/add_card_background"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Credits cash"
                            android:textColor="#DC2626"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Name"
                            android:textColor="#4A5568"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <EditText
                            android:id="@+id/et_cash_name_credit"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/edit_text_bg"
                            android:hint="Enter name"
                            android:inputType="textPersonName"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Credit Cash"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <EditText
                            android:id="@+id/et_credit_cash_amount"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rate Cutting"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <EditText
                            android:id="@+id/et_credit_rate_cutting"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/edit_text_bg"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:hint="0.00"
                            android:layout_marginBottom="12dp" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Credit Pure"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tv_credit_cash_pure"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:text="0.00"
                            android:background="#FEF2F2"
                            android:gravity="center"
                            android:padding="8dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#DC2626"
                            android:layout_marginBottom="12dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginVertical="8dp" />


                    </LinearLayout>

                </LinearLayout>


                <!-- Action Button -->
                <Button
                    android:id="@+id/btnRemoveCashRow"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Remove Row"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center"
                    android:backgroundTint="#DC2626"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="2dp"
                    app:cornerRadius="15dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Add Row Button -->
    <Button
        android:id="@+id/fab_add_row"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="+"
        android:textColor="@android:color/white"
        android:background="@drawable/info_header_gradient"
        android:textSize="28sp"
