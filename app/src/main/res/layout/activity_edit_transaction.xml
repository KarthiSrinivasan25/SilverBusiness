<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/abstract_background"
    android:padding="8dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Add top margin for status bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:minHeight="24dp" />

        <!-- Header with Glass Morphism -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/header_glass_morphism"
            android:layout_marginBottom="8dp"
            android:elevation="8dp">

            <!-- Main Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSACTION DETAILS"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:layout_marginBottom="16dp" />

            <!-- Status Stats Cards Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3"
                android:padding="3dp"
                android:background="@drawable/stats_container_bg"
                android:paddingVertical="8dp"
                android:layout_marginBottom="5dp">

                <!-- Status Open Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="5dp"
                    android:background="@drawable/stat_card_bg"
                    android:layout_margin="2dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/open"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_status_open"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPEN"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:alpha="0.8"
                        android:letterSpacing="0.05" />

                </LinearLayout>

                <!-- Status Close Card -->
                <!-- Status Close Card - Changed to Clickable Button -->
                <LinearLayout
                    android:id="@+id/status_close_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="5dp"
                    android:background="@drawable/stat_card_bg"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@null"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:stateListAnimator="@null">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/closed"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_status_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLOSED"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:alpha="0.8"
                        android:letterSpacing="0.05" />

                </LinearLayout>

                <!-- Total Transactions Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="5dp"
                    android:background="@drawable/stat_card_current_bg"
                    android:layout_margin="2dp"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/notes"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_total_transactions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:alpha="0.8"
                        android:letterSpacing="0.05" />

                </LinearLayout>

            </LinearLayout>

            <!-- Selection Info and Select All Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/stats_container_bg"
                android:padding="5dp"
                android:layout_marginBottom="8dp"
                android:weightSum="3">

                <!-- Selection Count -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected: "
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_selected_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" transactions"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:paddingStart="4dp" />

                </LinearLayout>

                <!-- Select All Button -->
                <Button
                    android:id="@+id/btn_select_all"
                    android:layout_width="0dp"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:text="Select All"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_select_all_bg" />

            </LinearLayout>

            <!-- Action Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3"
                android:background="@drawable/stats_container_bg"
                android:padding="5dp">

                <!-- Add Transaction Button with Icon -->
                <ImageButton
                    android:id="@+id/btn_add_transaction"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:src="@drawable/clipboard"
                    android:background="@drawable/stat_card_bg"
                    android:contentDescription="Add Transaction"
                    android:layout_marginEnd="4dp" />

                <!-- Finalize Button with Icon -->
                <ImageButton
                    android:id="@+id/btnclose_dialog"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/stat_card_bg"
                    android:contentDescription="Finalize"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.6"
                    android:enabled="false" />

                <!-- Current Page / Total Page Display -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/stat_card_bg"
                    android:layout_marginStart="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/page"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_page_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1/1"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- Pagination with Page Numbers -->
        <LinearLayout
            android:id="@+id/pagination_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/abstract_container"
            android:layout_marginBottom="10dp">

            <!-- Page Navigation Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="5">

                <!-- First Page Button -->
                <ImageButton
                    android:id="@+id/btn_first_page"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_first_page"
                    android:scaleType="centerInside"
                    android:background="@drawable/stat_card_bg"
                    android:contentDescription="First Page"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp" />

                <!-- Previous Page Button -->
                <ImageButton
                    android:id="@+id/btn_previous_page"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_previous_page"
                    android:scaleType="centerInside"
                    android:background="@drawable/stat_card_bg"
                    android:contentDescription="Previous Page"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp" />

                <!-- Single Page Number Display -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Current Page Number (Highlighted) -->
                    <TextView
                        android:id="@+id/tv_current_page_number"
                        android:layout_width="50dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/page_number_bg_selected" />

                </LinearLayout>

                <!-- Next Page Button -->
                <ImageButton
                    android:id="@+id/btn_next_page"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_next_page"
                    android:scaleType="centerInside"
                    android:background="@drawable/stat_card_bg"
                    android:contentDescription="Next Page"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp" />

                <!-- Last Page Button -->
                <ImageButton
                    android:id="@+id/btn_last_page"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_last_page"
                    android:scaleType="centerInside"
                    android:background="@drawable/stat_card_bg"
                    android:contentDescription="Last Page"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Go to Page Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="@drawable/stats_container_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Go to page:"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_go_to_page"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:background="@drawable/go_to_text"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:hint=""
                    android:padding="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_total_pages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 0"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_go_to_page"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Go"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/go_button_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

            </LinearLayout>

        </LinearLayout>
        <!-- Transaction List with Glass Effect -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/glass_morphism_effect"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transaction List"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="12dp"
                android:alpha="0.9" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/transaction_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Rows with cards will be added programmatically here -->

                </LinearLayout>
            </ScrollView>
        </LinearLayout>



        <!-- Abstract Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/abstract_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• PST Silver Ledger •"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:alpha="0.7"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:letterSpacing="0.2" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/abstract_divider" />

        </LinearLayout>

        <!-- Add bottom margin for navigation bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:minHeight="16dp" />

    </LinearLayout>
</ScrollView>