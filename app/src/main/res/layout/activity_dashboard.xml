<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/add_activity">

    <!-- ========================================================= -->
    <!-- DASHBOARD CONTENT -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PST Silver Ledger"
                    android:textSize="20sp"
                    android:textColor="#1A237E"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:id="@+id/profileContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/welcomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome"
                        android:textSize="10sp"
                        android:textColor="#1A237E"
                        android:layout_marginBottom="4dp" />

                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/user_icon"
                        android:contentDescription="Profile" />

                    <TextView
                        android:id="@+id/userNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guest"
                        android:textSize="10sp"
                        android:textColor="#1A237E"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- THREE MENU CARDS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="40dp">

                <!-- ADD CUSTOMER -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_add_customer"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    card_view:cardCornerRadius="16dp"
                    card_view:cardElevation="8dp"
                    card_view:cardBackgroundColor="#FFFFFF"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/card_lift">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/card_gradient_blue">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_add_customer"
                            android:contentDescription="Add Customer"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add Customer"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- VIEW CUSTOMER -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_view_customer"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    card_view:cardCornerRadius="16dp"
                    card_view:cardElevation="8dp"
                    card_view:cardBackgroundColor="#FFFFFF"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/card_lift">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/card_gradient_green">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_view_customers"
                            android:contentDescription="View Customer"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Customers"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- STATISTICS -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/rotating_stats_card"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    card_view:cardCornerRadius="16dp"
                    card_view:cardElevation="8dp"
                    card_view:cardBackgroundColor="#FFFFFF"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/card_lift">

                    <!-- FRONT -->

                    <LinearLayout
                        android:id="@+id/card_front"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stats_card_gradient_blue"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_people"
                            android:contentDescription="Total Customers"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/total_customers_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- BACK -->

                    <LinearLayout
                        android:id="@+id/card_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stats_card_gradient_purple"
                        android:padding="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_transaction"
                            android:contentDescription="Total Transactions"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/total_transactions_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- MURUGAR LOGO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="30dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    card_view:cardCornerRadius="90dp"
                    card_view:cardElevation="12dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/logoImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Murugar Logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ஸ்ரீ முருகன் துணை"
                    android:textSize="24sp"
                    android:textColor="#1A237E"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#22000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                card_view:cardCornerRadius="20dp"
                card_view:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:background="@drawable/footer_silver_gradient">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calculator"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SILVER CALCULATIONS"
                            android:textSize="14sp"
                            android:textColor="#2C3E50"
                            android:textStyle="bold"
                            android:letterSpacing="0.02" />

                    </LinearLayout>

                    <View
                        android:layout_width="140dp"
                        android:layout_height="1.5dp"
                        android:background="@drawable/silver_divider"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/secure_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Secure"
                            android:textSize="10sp"
                            android:textColor="#5D6D7E"
                            android:background="@drawable/chip_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/accurate_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accurate"
                            android:textSize="10sp"
                            android:textColor="#5D6D7E"
                            android:background="@drawable/chip_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/fast_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fast"
                            android:textSize="10sp"
                            android:textColor="#5D6D7E"
                            android:background="@drawable/chip_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Version 2.0"
                            android:textSize="10sp"
                            android:textColor="#95A5A6"
                            android:layout_marginEnd="12dp" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="3dp"
                            android:background="@drawable/circle_silver"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="© 2025 PST Silver Ledger"
                            android:textSize="10sp"
                            android:textColor="#95A5A6" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationCard"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_margin="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- ================================================= -->
            <!-- HOME -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/bottom_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <!-- ICON + DOT CONTAINER -->

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:id="@+id/home_icon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        android:contentDescription="Home" />

                    <!-- TOP RIGHT BLINKING DOT -->

                    <View
                        android:id="@+id/home_selected_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/selected_dot" />

                </FrameLayout>

                <TextView
                    android:id="@+id/home_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:layout_marginTop="1dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- KACHA -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/bottom_kacha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <!-- ICON + DOT CONTAINER -->

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:id="@+id/kacha_icon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_kacha"
                        android:contentDescription="Kacha" />

                    <!-- TOP RIGHT BLINKING DOT -->

                    <View
                        android:id="@+id/kacha_selected_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/selected_dot"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/kacha_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kacha"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#7F8C8D"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>