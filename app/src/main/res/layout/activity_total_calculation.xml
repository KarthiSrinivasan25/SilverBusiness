<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    android:background="@drawable/add_activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:padding="24dp"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transaction Summary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_transaction_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Today • 14:30 PM"
                    android:textColor="#B3ED3838"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_export_pdf"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/ic_pdf"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Balance Stats in Single Line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/total_header_bg"
            android:padding="20dp"
            android:elevation="6dp">

            <!-- Debit -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Debit"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_total_debit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹12,500"
                    android:textColor="#38A169"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:background="#38A169"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#87888A"
                android:layout_gravity="center" />

            <!-- Credit -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credit"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_total_credit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹8,750"
                    android:textColor="#E53E3E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:background="#E53E3E"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#87888A"
                android:layout_gravity="center" />

            <!-- Net Balance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remaining"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_total_sum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹3,750"
                    android:textColor="#E53E3E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tv_balance_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Positive"
                    android:textColor="#38A169"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>

        <!-- Transaction List Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/content_card_bg"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transaction Details"
                android:textColor="#2D3748"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium" />

            <!-- List Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="@drawable/info_item_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:text="Transaction Name"
                    android:textColor="#4A5568"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Debit Pure"
                    android:textColor="#4A5568"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:letterSpacing="0.02"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Credit Pure"
                    android:textColor="#4A5568"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:letterSpacing="0.02"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <!-- Transaction Items -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transaction_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Wrapper for Total and Remainder sections -->
            <LinearLayout
                android:id="@+id/ll_total_remainder_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <!-- Simple Total Row -->
                <LinearLayout
                    android:id="@+id/ll_simple_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/simple_total_background"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="Total"
                        android:textColor="#2D3748"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_simple_debit_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="₹0.00"
                        android:textColor="#43A047"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_simple_credit_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="₹0.00"
                        android:textColor="#E53935"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <!-- Dynamic Remainder/Balance Row -->
                <!-- Default background - will be changed programmatically -->
                <LinearLayout
                    android:id="@+id/ll_remainder_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/button_background"
                    android:layout_marginTop="4dp"
                    android:padding="14dp"
                    android:elevation="0dp"
                    android:visibility="gone">

                    <!-- Label that changes based on remainder type -->
                    <TextView
                        android:id="@+id/tv_remainder_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text=""
                        android:textColor="#2D3748"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <!-- Debit Column for Remainder (Balance Pure) -->
                    <TextView
                        android:id="@+id/tv_remainder_debit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#43A047"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:fontFamily="sans-serif" />

                    <!-- Credit Column for Remainder (Ex Pure) -->
                    <TextView
                        android:id="@+id/tv_remainder_credit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#E53935"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Pagination Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btn_previous"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_previous"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="visible" />

            <!-- Page indicator -->
            <TextView
                android:id="@+id/tv_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page 1 of 1"
                android:textSize="14sp"
                android:textColor="#4A5568" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_next"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="visible" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>