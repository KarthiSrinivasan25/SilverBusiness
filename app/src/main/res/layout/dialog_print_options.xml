<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Page Range"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rg_print_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rb_all_pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All Pages"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_current_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Page Only" />

        <RadioButton
            android:id="@+id/rb_custom_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom Range" />

    </RadioGroup>

    <LinearLayout
        android:id="@+id/range_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_start_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:hint="Start"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="to"
            android:padding="12dp" />

        <EditText
            android:id="@+id/et_end_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:hint="End"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Print Settings"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Copies:" />

        <NumberPicker
            android:id="@+id/np_copies"
            android:layout_width="100dp"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Orientation:" />

        <Spinner
            android:id="@+id/spinner_orientation"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:entries="@array/orientation_options" />

    </LinearLayout>

</LinearLayout>