<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_overlay_bg">

    <!-- 📦 Main Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_container"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="48dp">

            <!-- 🏢 Company Logo with Shadow -->
            <androidx.cardview.widget.CardView
                android:id="@+id/logo_container"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/company_logo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_launcher_round"
                    android:contentDescription="Company Logo"
                    android:layout_gravity="center"
                    android:scaleType="centerInside" />

            </androidx.cardview.widget.CardView>

            <!-- 🔐 Title -->
            <TextView
                android:id="@+id/title"
                android:text="Welcome Back"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtitle"
                android:text="PST Silver Ledger"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- 📦 Card Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- 🔒 Password Field Container -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="SECURITY VERIFICATION"
                            android:textSize="11sp"

                            android:textColor="#999999"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="12dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <!-- Password Input with Border -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:background="@drawable/edittext_modern_bg"
                            android:padding="14dp"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:src="@android:drawable/ic_lock_lock"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                app:tint="#4CAF50" />

                            <EditText
                                android:id="@+id/security_password"
                                android:hint="Enter your password"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="#1A1A1A"
                                android:textSize="15sp"
                                android:inputType="textPassword" />

                            <ImageView
                                android:id="@+id/toggle_password"
                                android:src="@android:drawable/ic_menu_view"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                app:tint="#2E7D32" />

                        </LinearLayout>

                        <!-- Password Hint -->
<!--                        <TextView-->
<!--                            android:text="🔒 Password must be 6+ characters"-->
<!--                            android:textSize="10sp"-->
<!--                            android:textColor="#999999"-->
<!--                            android:layout_marginTop="8dp"-->
<!--                            android:layout_marginStart="4dp"-->
<!--                            android:layout_width="wrap_content"-->
<!--                            android:layout_height="wrap_content" />-->

                    </LinearLayout>

                    <!-- ✅ Verify Button -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/verify_button"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="24dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="6dp"
                        android:backgroundTint="#2E7D32">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:text="VERIFY ACCESS"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <ImageView
                                android:src="@android:drawable/ic_menu_send"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="8dp"
                                app:tint="#FFFFFF" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>