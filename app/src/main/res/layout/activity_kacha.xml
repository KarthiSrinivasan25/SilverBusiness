<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kachaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/kacha_bg"
    android:fitsSystemWindows="true">

    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/kachaScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ================================================= -->
            <!-- ACTION / SUMMARY BAR -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="14dp"
                card_view:cardCornerRadius="20dp"
                card_view:cardElevation="4dp"
                card_view:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <!-- ADD KACHA BUTTON -->
                    <LinearLayout
                        android:id="@+id/btn_add_kacha"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1.45"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/add_kacha_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="+"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add Kacha"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New record"
                                android:textSize="8sp"
                                android:textColor="#DDE2FF"
                                android:layout_marginTop="1dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="9dp"
                        android:layout_marginEnd="9dp"
                        android:background="#E5E7EB" />

                    <!-- TOTAL -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="0.75"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:textColor="#98A2B3" />

                        <TextView
                            android:id="@+id/tv_total_kacha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginTop="1dp" />

                    </LinearLayout>

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="#E5E7EB" />

                    <!-- PAGE -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="0.75"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PAGE"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:textColor="#98A2B3" />

                        <TextView
                            android:id="@+id/tv_page_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 / 0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginTop="1dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- PAGINATION CARD -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                card_view:cardCornerRadius="18dp"
                card_view:cardElevation="3dp"
                card_view:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- PAGE BUTTONS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_first_page"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="|&lt;"
                            android:textSize="11sp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:background="@drawable/pagination_button_bg"
                            android:textColor="#1A237E" />

                        <Button
                            android:id="@+id/btn_previous_page"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="‹"
                            android:textSize="18sp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/pagination_button_bg"
                            android:textColor="#1A237E" />

                        <TextView
                            android:id="@+id/tv_current_page"
                            android:layout_width="44dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/page_selected_bg"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_next_page"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="›"
                            android:textSize="18sp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/pagination_button_bg"
                            android:textColor="#1A237E" />

                        <Button
                            android:id="@+id/btn_last_page"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="&gt;|"
                            android:textSize="11sp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/pagination_button_bg"
                            android:textColor="#1A237E" />

                    </LinearLayout>

                    <!-- GO TO PAGE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Go to page"
                            android:textSize="11sp"
                            android:textColor="#667085" />

                        <EditText
                            android:id="@+id/et_go_page"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="Page"
                            android:inputType="number"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:background="@drawable/edittext_background"
                            android:textColor="#1A237E"
                            android:textColorHint="#98A2B3" />

                        <Button
                            android:id="@+id/btn_go_page"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:text="GO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginStart="7dp"
                            android:background="@drawable/go_button_bg"
                            android:textColor="#FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- DATA HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kacha Records"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />

                <TextView
                    android:id="@+id/tv_record_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 records"
                    android:textSize="10sp"
                    android:textColor="#98A2B3" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- GRID (2 Columns) -->
            <!-- ================================================= -->

            <GridLayout
                android:id="@+id/kacha_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false" />

            <!-- EMPTY STATE -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Kacha Records"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#667085"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Add Kacha to create your first record"
                    android:textSize="11sp"
                    android:textColor="#98A2B3"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ===================================================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ===================================================== -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        card_view:cardCornerRadius="0dp"
        card_view:cardElevation="12dp"
        card_view:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- HOME -->
            <LinearLayout
                android:id="@+id/bottom_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        android:contentDescription="Home" />

                    <View
                        android:id="@+id/home_selected_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/selected_dot"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#7F8C8D" />

            </LinearLayout>

            <!-- KACHA -->
            <LinearLayout
                android:id="@+id/bottom_kacha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_kacha"
                        android:contentDescription="Kacha" />

                    <View
                        android:id="@+id/kacha_selected_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/selected_dot"
                        android:visibility="visible" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kacha"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>