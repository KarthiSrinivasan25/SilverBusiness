<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid background as base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF8E1"/>
        </shape>
    </item>

    <!-- Gradient overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFF8E1"
                android:centerColor="#FFF3C0"
                android:endColor="#FFE082"
                android:angle="270" />
        </shape>
    </item>

    <!-- Top gray bar -->
    <item android:height="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#A9A9A9"/>
        </shape>
    </item>
</layer-list>