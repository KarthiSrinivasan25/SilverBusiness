<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Light background like XML layout -->
    <solid android:color="#F8F7F7" />

    <!-- Soft light gray border -->
    <stroke
        android:width="1dp"
        android:color="#D1CFCF" />

    <!-- Smooth curve edges -->
    <corners android:radius="16dp" />

    <!-- Inner padding to make text look balanced -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

    <!-- Slight shadow look (optional) -->
    <size
        android:width="0dp"
        android:height="45dp" />
</shape>
